-- Provisions the catalog service's database and roles. Idempotent: safe to re-run.
-- Run through catalog.sh, which passes the passwords as psql variables.
--
--   catalog_migrator  owns the database and every object in it; runs migrations
--   catalog_app       reads and writes rows only; used by the running service
--   catalog_reader    reads rows only; for people inspecting data (SQL clients)

-- Postgres has no CREATE ROLE IF NOT EXISTS: build the statement, then \gexec runs it
SELECT format('CREATE ROLE catalog_migrator LOGIN PASSWORD %L', :'migrator_password')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'catalog_migrator') \gexec
SELECT format('CREATE ROLE catalog_app LOGIN PASSWORD %L', :'app_password')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'catalog_app') \gexec
SELECT format('CREATE ROLE catalog_reader LOGIN PASSWORD %L', :'reader_password')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'catalog_reader') \gexec

-- Keep passwords in sync with .env on re-runs
ALTER ROLE catalog_migrator PASSWORD :'migrator_password';
ALTER ROLE catalog_app PASSWORD :'app_password';
ALTER ROLE catalog_reader PASSWORD :'reader_password';

-- Local only: prisma migrate dev creates a temporary shadow database
ALTER ROLE catalog_migrator CREATEDB;

-- A second safety layer for people: their sessions start read-only
ALTER ROLE catalog_reader SET default_transaction_read_only = on;

-- CREATE DATABASE can't run in a transaction block (or a DO block), hence \gexec again
SELECT 'CREATE DATABASE catalog OWNER catalog_migrator'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'catalog') \gexec

REVOKE ALL ON DATABASE catalog FROM PUBLIC;
GRANT CONNECT ON DATABASE catalog TO catalog_app, catalog_reader;

\connect catalog

-- The database owner (catalog_migrator) owns schema public; nobody else may create in it
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO catalog_app, catalog_reader;

-- Grants on objects that catalog_migrator creates later, in future migrations
ALTER DEFAULT PRIVILEGES FOR ROLE catalog_migrator IN SCHEMA public
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO catalog_app;
ALTER DEFAULT PRIVILEGES FOR ROLE catalog_migrator IN SCHEMA public
  GRANT USAGE, SELECT ON SEQUENCES TO catalog_app;
ALTER DEFAULT PRIVILEGES FOR ROLE catalog_migrator IN SCHEMA public
  GRANT SELECT ON TABLES TO catalog_reader;

-- Default privileges only cover future tables. Tables that already exist (when a role
-- is added after the first migrations) need a one-time grant.
GRANT SELECT ON ALL TABLES IN SCHEMA public TO catalog_reader;
