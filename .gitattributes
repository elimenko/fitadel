# Normalize all text files to LF, in the repo and in the working tree, on every OS
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings, never diff as text
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.jar      binary
*.keystore binary

# Collapse the lockfile in GitHub diffs
pnpm-lock.yaml linguist-generated=true
