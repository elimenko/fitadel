{
  "name": "@fitadel/catalog",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "catalog",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/services/catalog/dist/package.json",
          "{workspaceRoot}/apps/services/catalog/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/services/catalog/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/services/catalog/dist/patches",
          "{workspaceRoot}/apps/services/catalog/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/services/catalog/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "readyWhen": {
          "signal": true
        },
        "options": {
          "buildTarget": "catalog:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "catalog:build:development"
          },
          "production": {
            "buildTarget": "catalog:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        },
        "dependsOn": [
          "prisma-generate",
          "^build"
        ]
      },
      "prisma-generate": {
        "command": "prisma generate",
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "CHECKPOINT_DISABLE": "1"
          }
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts",
          {
            "externalDependencies": [
              "prisma"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma"
        ]
      },
      "prisma": {
        "command": "prisma",
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "CHECKPOINT_DISABLE": "1"
          },
          "forwardAllArgs": true
        }
      },
      "build": {
        "dependsOn": [
          "prisma-generate",
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "prisma-generate",
          "^typecheck"
        ]
      },
      "lint": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "integration": {
        "command": "jest --config jest.integration.config.cts",
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "NODE_OPTIONS": "--experimental-vm-modules"
          }
        },
        "dependsOn": [
          "prisma-generate",
          "^build"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/tools/db/**",
          "{workspaceRoot}/compose.yaml",
          {
            "externalDependencies": [
              "@testcontainers/postgresql",
              "prisma"
            ]
          }
        ]
      }
    },
    "tags": [
      "platform:node"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
