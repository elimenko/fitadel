    },
    "/v1/foods": {
      "get": {
        "operationId": "FoodController_search_v1",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Chooses the display name, e.g. \"ru-RU,ru;q=0.9,en;q=0.8\"",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": true,
            "in": "query",
            "description": "Words or the start of words, in any language; accents optional",
            "schema": {
              "minLength": 2,
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "maximum": 1000,
              "default": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of matching foods",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResultDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": ["foods"]
      }
    },
    "/v1/foods/barcode/{code}": {
      "get": {
        "operationId": "FoodController_findByBarcode_v1",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Chooses the display name, e.g. \"ru-RU,ru;q=0.9,en;q=0.8\"",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "required": true,
            "in": "path",
            "description": "EAN-8, UPC-A, EAN-13 or GTIN-14, as printed",
            "schema": {
              "pattern": "^\\d{8,14}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The best match, plus alternatives",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BarcodeLookupDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid barcode (wrong length, or a mistyped digit)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "Neither the catalog nor Open Food Facts has a usable food with this barcode",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": ["foods"]
      }
    }
  },
  "info": {
    "title": "Fitadel catalog API",
    "description": "Foods with nutrition values, barcode lookup and search. Errors use RFC 9457 problem details (application/problem+json).",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "description": "Validation errors, one per invalid field",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"]
            }
          }
        },
        "required": ["type", "title", "status", "instance"],
        "description": "RFC 9457 problem details"
      },
      "Food_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "source": {
            "type": "string",
            "enum": ["off", "usda", "user"],
            "description": "off = Open Food Facts, user = entered by a user"
          },
          "sourceRef": {
            "description": "The id at the source, e.g. the Open Food Facts code",
            "type": ["string", "null"]
          },
          "barcode": {
            "description": "GTIN-14: 14 digits, zero-padded",
            "type": ["string", "null"]
          },
          "name": {
            "type": "string",
            "description": "Display name: the first Accept-Language with a name, else Polish, English or any"
          },
          "names": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "All names by language code, e.g. { \"pl\": \"Twaróg\" }"
          },
          "brand": {
            "type": ["string", "null"]
          },
          "basis": {
            "type": "string",
            "enum": ["g", "ml"],
            "description": "Nutrient values are per 100 g or per 100 ml"
          },
          "per100": {
            "type": "object",
            "properties": {
              "kcal": {
                "type": "number"
              },
              "protein": {
                "description": "Grams; null when unknown (not 0)",
                "type": ["number", "null"]
              },
              "fat": {
                "description": "Grams; null when unknown (not 0)",
                "type": ["number", "null"]
              },
              "carbs": {
                "description": "Grams; null when unknown (not 0)",
                "type": ["number", "null"]
              },
              "sugars": {
                "description": "Grams; null when unknown (not 0)",
                "type": ["number", "null"]
              },
              "fiber": {
                "description": "Grams; null when unknown (not 0)",
                "type": ["number", "null"]
              },
              "saturatedFat": {
                "description": "Grams; null when unknown (not 0)",
                "type": ["number", "null"]
              },
              "salt": {
                "description": "Grams; null when unknown (not 0)",
                "type": ["number", "null"]
              }
            },
            "required": [
              "kcal",
              "protein",
              "fat",
              "carbs",
              "sugars",
              "fiber",
              "saturatedFat",
              "salt"
            ],
            "additionalProperties": false
          },
          "otherNutrients": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": ["value", "unit"],
              "additionalProperties": false
            },
            "description": "Vitamins, minerals etc. per 100 g or 100 ml, for display"
          },
          "servings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "amount": {
                  "type": "number",
                  "description": "In the basis unit (g or ml)"
                }
              },
              "required": ["label", "amount"],
              "additionalProperties": false
            }
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Where it is sold, e.g. [\"poland\", \"ireland\"]"
          }
        },
        "required": [
          "id",
          "source",
          "sourceRef",
          "barcode",
          "name",
          "names",
          "brand",
          "basis",
          "per100",
          "otherNutrients",
          "servings",
          "countries"
        ],
        "additionalProperties": false
      },
      "SearchResultDto_Output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Food_Output"
            },
            "description": "Foods sold in Poland first, then by match quality and popularity"
          },
          "nextOffset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as offset for the next page; null on the last page. There is no total count: counting every match would be as slow as the slowest search."
          }
        },
        "required": ["items", "nextOffset"],
        "description": "A page of search results",
        "additionalProperties": false
      },
      "BarcodeLookupDto_Output": {
        "type": "object",
        "properties": {
          "food": {
            "description": "The best match",
            "$ref": "#/components/schemas/Food_Output"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Food_Output"
            },
            "description": "Other foods with this barcode, best first"
          }
        },
        "required": ["food", "alternatives"],
        "description": "A barcode lookup result",
        "additionalProperties": false
      }
    }
  }
}
