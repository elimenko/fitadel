# Local configuration for the catalog service.
# Copy to .env (gitignored); Nx loads it into every catalog task (serve, test, ...).
# In CI and AWS the same variables come from the platform instead.

PORT=3000

# The service connects as catalog_app (rows only); prisma migrate as catalog_migrator.
# ${...} values come from the root .env, which Nx loads too.
DATABASE_URL=postgresql://catalog_app:${CATALOG_APP_PASSWORD}@localhost:${POSTGRES_PORT}/catalog
MIGRATION_DATABASE_URL=postgresql://catalog_migrator:${CATALOG_MIGRATOR_PASSWORD}@localhost:${POSTGRES_PORT}/catalog

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# OpenTelemetry (standard SDK variables): send traces, metrics and logs as OTLP over
# HTTP to the local otel-lgtm container (compose.yaml). Set OTEL_SDK_DISABLED=true to turn off.
OTEL_SERVICE_NAME=catalog
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Export metrics every 10 s instead of the default 60 s, to see them quickly locally
OTEL_METRIC_EXPORT_INTERVAL=10000

# Access tokens from the identity service (the defaults match its local setup).
# Get one with `pnpm nx run fitadel-dev:token`. The issuer is the gateway's URL; the
# keys are fetched from identity directly, since calls between services skip the gateway.
# AUTH_ISSUER=http://localhost:8080/oidc
# AUTH_AUDIENCE=https://api.fitadel.local
AUTH_JWKS_URI=http://localhost:3010/oidc/jwks
