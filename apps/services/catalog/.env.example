# Local configuration for the catalog service.
# Copy to .env (gitignored); Nx loads it into every catalog task (serve, test, ...).
# In CI and AWS the same variables come from the platform instead.

PORT=3000

# The service connects as catalog_app (rows only); prisma migrate as catalog_migrator.
# ${...} values come from the root .env, which Nx loads too.
DATABASE_URL=postgresql://catalog_app:${CATALOG_APP_PASSWORD}@localhost:${POSTGRES_PORT}/catalog
MIGRATION_DATABASE_URL=postgresql://catalog_migrator:${CATALOG_MIGRATOR_PASSWORD}@localhost:${POSTGRES_PORT}/catalog
