# Local configuration for the identity service.
# Copy to .env (gitignored); Nx loads it into every identity task (serve, test, ...).
# In CI and AWS the same variables come from the platform instead.

PORT=3010

# The service connects as identity_app (rows only); prisma migrate as identity_migrator.
# ${...} values come from the root .env, which Nx loads too.
DATABASE_URL=postgresql://identity_app:${IDENTITY_APP_PASSWORD}@localhost:${POSTGRES_PORT}/identity
MIGRATION_DATABASE_URL=postgresql://identity_migrator:${IDENTITY_MIGRATOR_PASSWORD}@localhost:${POSTGRES_PORT}/identity

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# OpenTelemetry (standard SDK variables): send traces, metrics and logs as OTLP over
# HTTP to the local otel-lgtm container (compose.yaml). Set OTEL_SDK_DISABLED=true to turn off.
OTEL_SERVICE_NAME=identity
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Export metrics every 10 s instead of the default 60 s, to see them quickly locally
OTEL_METRIC_EXPORT_INTERVAL=10000

# Behind the gateway (compose.yaml): trust its X-Forwarded-For entry as the client IP.
# Use 0 when clients reach the service directly, or they can choose their own IP.
TRUST_PROXY_HOPS=1

# OpenID Provider. The issuer must match exactly what clients see (iss claim): the
# gateway's URL, not the service's own port.
# OIDC_ISSUER=http://localhost:8080/oidc
# OIDC_API_AUDIENCE=https://api.fitadel.local
# Signing and cookie keys (secrets): run `nx run identity:generate-keys`, which appends
# OIDC_JWKS and OIDC_COOKIE_KEYS to .env. On AWS they come from Secrets Manager.

# Outgoing email. The defaults reach Mailpit from compose.yaml (inbox at
# http://localhost:8025); nothing is delivered to real addresses.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Fitadel <no-reply@fitadel.local>

# Reject passwords found in data breaches (Have I Been Pwned range API). Set to
# disabled to work offline; when the API is unreachable the check fails open anyway.
# PASSWORD_BREACH_CHECK=enabled

# Sign-in with Google: an OAuth client of type "Web application" in Google Cloud, with
# the redirect URI http://localhost:8080/interaction/google/callback. Without both
# values the button is hidden. The secret is a secret: .env only, never committed.
# GOOGLE_CLIENT_ID=…apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=…
