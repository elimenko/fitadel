# Local configuration for the identity service.
# Copy to .env (gitignored); Nx loads it into every identity task (serve, test, ...).
# In CI and AWS the same variables come from the platform instead.

PORT=3010

# The service connects as identity_app (rows only); prisma migrate as identity_migrator.
# ${...} values come from the root .env, which Nx loads too.
DATABASE_URL=postgresql://identity_app:${IDENTITY_APP_PASSWORD}@localhost:${POSTGRES_PORT}/identity
MIGRATION_DATABASE_URL=postgresql://identity_migrator:${IDENTITY_MIGRATOR_PASSWORD}@localhost:${POSTGRES_PORT}/identity
