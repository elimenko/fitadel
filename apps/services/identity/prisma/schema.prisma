// Identity data model: accounts and how they sign in, plus oidc-provider's own storage
// (codes, sessions, grants, refresh tokens) in oidc_payload.
// Hand-written SQL in the migrations adds what Prisma can't express: CHECK constraints
// and the grants for identity_reader, which only sees tables granted explicitly
// (tools/db/identity.psql).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  contributor

  @@map("role")
}

model Account {
  /// Also the `sub` claim in tokens
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Login name, stored trimmed and lowercased (a CHECK in the migration enforces it)
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  displayName     String?   @map("display_name")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  password     AccountPassword?
  identities   AccountIdentity[]
  roles        AccountRole[]     @relation("roles")
  rolesGranted AccountRole[]     @relation("grantedBy")

  @@map("account")
}

/// Secret: not granted to identity_reader
model AccountPassword {
  accountId String   @id @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// PHC string: $argon2id$v=19$m=…,t=…,p=…$<salt>$<hash>
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("account_password")
}

/// Sign-in through an external provider (Google in Phase 2 Step 5)
model AccountIdentity {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The provider's `iss`, e.g. https://accounts.google.com
  issuer    String
  /// The provider's `sub` for this person
  subject   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([issuer, subject])
  @@index([accountId])
  @@map("account_identity")
}

model AccountRole {
  accountId   String   @map("account_id") @db.Uuid
  account     Account  @relation("roles", fields: [accountId], references: [id], onDelete: Cascade)
  role        Role
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz
  /// NULL when granted by a script rather than a person
  grantedById String?  @map("granted_by") @db.Uuid
  grantedBy   Account? @relation("grantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([accountId, role])
  @@map("account_role")
}

/// oidc-provider's storage: one row per object the engine keeps (authorization code,
/// session, grant, refresh token, interaction, …). The engine owns the payload's shape;
/// the columns exist for the lookups and the atomic consume.
/// Secret: never granted to identity_reader.
model OidcPayload {
  /// The engine's model name, e.g. AuthorizationCode, RefreshToken, Session
  model      String
  /// SHA-256 of the engine's id. For codes and tokens the id is the secret itself, so a
  /// leaked backup must not contain it.
  id         Bytes     @db.ByteA
  payload    Json
  /// Set on codes and tokens; revoking a grant deletes all of its rows
  grantId    String?   @map("grant_id")
  /// Set on sessions (the engine looks them up by uid)
  uid        String?
  /// Device flow only (disabled), kept so the adapter interface is complete
  userCode   String?   @map("user_code")
  /// NULL for objects without an expiry
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  /// Set once, atomically, when a code or refresh token is used
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz

  @@id([model, id])
  @@index([grantId])
  @@index([uid])
  @@index([expiresAt])
  @@map("oidc_payload")
}

/// Fixed-window counters for rate limits (src/rate-limit). Keys hold IP addresses and
/// email hashes: personal data, so not granted to identity_reader.
/// Registrations waiting for their email link. The account is created only when the
/// link is confirmed, so every account's email is verified and nobody can claim an
/// address they can't read. Holds password hashes: identity_reader gets no grant.
model PendingRegistration {
  /// SHA-256 of the token in the link; the token itself is never stored
  tokenHash    Bytes    @id @map("token_hash")
  /// Normalized like account.email; not unique: anyone may start a registration
  email        String
  displayName  String?  @map("display_name")
  passwordHash String   @map("password_hash")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([expiresAt])
  @@map("pending_registration")
}

/// Emails waiting to be sent (transactional outbox): written in the same transaction as
/// whatever the email is about, sent by a background loop, deleted once sent or given
/// up on. Until then the bodies hold secrets (verification and reset links), so
/// identity_reader gets no grant.
model EmailOutbox {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipient     String
  subject       String
  textBody      String   @map("text_body")
  htmlBody      String?  @map("html_body")
  attempts      Int      @default(0)
  /// When a sender may pick the row up: now for new rows, later after a failure or
  /// while a sender holds it
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([nextAttemptAt])
  @@map("email_outbox")
}

model RateLimit {
  /// What is limited and for whom, e.g. "sign-in:ip:203.0.113.7"
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit")
}
