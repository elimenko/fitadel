// Diary data model: goals (daily calorie budget and macro targets) and diary entries.
// Hand-written SQL in the migrations adds what Prisma can't express: CHECK constraints.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// How a goal changes maintenance calories into the daily budget
enum AdjustmentUnit {
  percent
  kcal

  @@map("adjustment_unit")
}

/// A daily goal, in effect from effectiveFrom until the user's next goal starts.
/// Stores what the user entered; the budget and carb target are computed on read.
model Goal {
  /// The account (`sub` of the access token)
  userId          String         @map("user_id") @db.Uuid
  effectiveFrom   DateTime       @map("effective_from") @db.Date
  maintenanceKcal Int            @map("maintenance_kcal")
  adjustmentUnit  AdjustmentUnit @map("adjustment_unit")
  /// Negative for a deficit: -20 (%) or -500 (kcal)
  adjustmentValue Int            @map("adjustment_value")
  proteinG        Int            @map("protein_g")
  fatG            Int            @map("fat_g")
  fiberG          Int            @map("fiber_g")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // One goal per user and start date. The key's index also finds the goal in effect
  // on a date: the user's latest effective_from on or before it.
  @@id([userId, effectiveFrom])
  @@map("goal")
}

enum Meal {
  breakfast
  lunch
  dinner
  snack

  @@map("meal")
}

enum NutrientBasis {
  g
  ml

  @@map("nutrient_basis")
}

/// Something the user ate: a food from the catalog with an amount, or a manual entry.
/// The values (kcal, macros) are for the whole entry, so a day's totals are a plain sum.
/// NULL macros are unknown, which is not the same as 0.
model DiaryEntry {
  /// uuidv7: sorts by creation time, which orders entries within a meal
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The account (`sub` of the access token)
  userId   String   @map("user_id") @db.Uuid
  /// The calendar day as the client sees it
  date     DateTime @db.Date
  meal     Meal
  name     String?
  kcal     Decimal  @db.Decimal(7, 1)
  proteinG Decimal? @map("protein_g") @db.Decimal(6, 1)
  fatG     Decimal? @map("fat_g") @db.Decimal(6, 1)
  carbsG   Decimal? @map("carbs_g") @db.Decimal(6, 1)
  fiberG   Decimal? @map("fiber_g") @db.Decimal(6, 1)

  /// Food entries only, NULL for manual ones (a CHECK keeps them all or nothing): the
  /// catalog food, the amount eaten and a copy of the food as it was when logged, so
  /// later changes to it don't rewrite the diary, and a new amount needs no catalog.
  foodId        String?        @map("food_id") @db.Uuid
  /// In the food's basis unit
  amount        Decimal?       @db.Decimal(6, 1)
  brand         String?
  basis         NutrientBasis?
  /// Per 100 g or per 100 ml, as in the catalog
  kcalPer100    Decimal?       @map("kcal_per_100") @db.Decimal(6, 2)
  proteinPer100 Decimal?       @map("protein_per_100") @db.Decimal(5, 2)
  fatPer100     Decimal?       @map("fat_per_100") @db.Decimal(5, 2)
  carbsPer100   Decimal?       @map("carbs_per_100") @db.Decimal(5, 2)
  fiberPer100   Decimal?       @map("fiber_per_100") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Every read is "the user's entries on a day"
  @@index([userId, date])
  @@map("diary_entry")
}
