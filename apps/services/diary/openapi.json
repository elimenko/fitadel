    "/v1/goals": {
      "get": {
        "operationId": "GoalController_list_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalListDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or an invalid or expired one",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": ["goals"]
      }
    },
    "/v1/goals/effective": {
      "get": {
        "operationId": "GoalController_effective_v1",
        "parameters": [
          {
            "name": "date",
            "required": true,
            "in": "query",
            "description": "The day to look up, as the client sees it (YYYY-MM-DD)",
            "schema": {
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The latest goal that started on or before the date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid date",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or an invalid or expired one",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "No goal in effect on that date",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": ["goals"]
      }
    },
    "/v1/goals/{effectiveFrom}": {
      "get": {
        "operationId": "GoalController_get_v1",
        "parameters": [
          {
            "name": "effectiveFrom",
            "required": true,
            "in": "path",
            "description": "A calendar date, YYYY-MM-DD",
            "schema": {
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid date",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or an invalid or expired one",
